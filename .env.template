# =============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE - TEMPLATE
# =============================================================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha os valores reais (substitua os exemplos)
# 3. NUNCA commite o arquivo .env no Git
# 4. Mantenha suas credenciais seguras
#
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE MONITORAMENTO
# -----------------------------------------------------------------------------
MONITOR_INTERVAL=30
MONITOR_TIMEOUT_PING=5
MONITOR_TIMEOUT_HTTP=10

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE ALERTAS
# -----------------------------------------------------------------------------
ALERTS_SOUND_ENABLED=true
ALERTS_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE EMAIL/SMTP
# -----------------------------------------------------------------------------
# IMPORTANTE: Use credenciais reais aqui, não valores de exemplo!
# Para Gmail: Use "Senhas de app" em vez da senha normal
# Para outros provedores: Consulte a documentação SMTP

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_aqui
EMAIL_FROM=noreply@suaempresa.com
EMAIL_TO=admin@suaempresa.com,suporte@suaempresa.com

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE LOG
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=monitor.log

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE SEGURANÇA
# -----------------------------------------------------------------------------
# Defina uma chave secreta para operações sensíveis (se necessário)
# SECRET_KEY=sua_chave_secreta_muito_longa_e_aleatoria_aqui

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE DESENVOLVIMENTO (OPCIONAL)
# -----------------------------------------------------------------------------
# DEBUG=false
# DEVELOPMENT_MODE=false

# =============================================================================
# NOTAS DE SEGURANÇA:
# 
# 1. NUNCA use valores reais neste arquivo template
# 2. SEMPRE use credenciais específicas para cada ambiente
# 3. Rotacione credenciais regularmente
# 4. Use "Senhas de app" para Gmail e outros provedores
# 5. Monitore logs de acesso para detectar uso não autorizado
# =============================================================================